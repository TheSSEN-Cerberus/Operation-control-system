<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tactical Color Palette -->
    <Color x:Key="TacticalBlack">#0C0C0C</Color>
    <Color x:Key="TacticalGray">#1E1E1E</Color>
    <Color x:Key="OliveGreen">#4E9F3D</Color>
    <Color x:Key="TacticalBlue">#3C91E6</Color>
    <Color x:Key="WarningRed">#C23B22</Color>
    <Color x:Key="Sand">#C1A87D</Color>
    <SolidColorBrush x:Key="HUDYellow" Color="#FFEB3B"/>

    <!-- Brush Versions -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource TacticalBlack}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource TacticalGray}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource OliveGreen}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningRed}"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="BorderBrushDark" Color="#2E2E2E"/>
</ResourceDictionary>
