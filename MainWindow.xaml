<Window x:Class="Operation_Control_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Operation_Control_System.ViewModels"
        xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
        xmlns:gmapcore="clr-namespace:GMap.NET.MapProviders;assembly=GMap.NET.Core"
        Title="4족 보행 로봇 운용 통제 시스템"
        Height="768" Width="1280"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded">


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/Panels.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- 영상 -->
            <ColumnDefinition Width="2*"/>
            <!-- 제어 및 상태 -->
        </Grid.ColumnDefinitions>

        <!-- 🎥 좌측: 영상 + BBox -->
        <Border Grid.Column="0" Margin="5" Background="#111" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 🎥 영상 영역 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 📋 Target Info (남는 공간 차지) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Image Source="{Binding VideoStream.CurrentFrame}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Ellipse Width="6" Height="6" Fill="Red"
         Stroke="Black" StrokeThickness="1"
         Canvas.Left="{Binding VideoStream.CenterX}"
         Canvas.Top="{Binding VideoStream.CenterY}"
         Panel.ZIndex="99"/>
                    <!-- 🎞 로딩 애니메이션 -->
                <Viewbox Stretch="Uniform"
         HorizontalAlignment="Center"
         VerticalAlignment="Top">
                    
                <Grid Visibility="{Binding VideoStream.CurrentFrame, Converter={StaticResource NullToVisibilityConverter}}"
              Background="#66000000"
              Width="640" Height="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="10" Foreground="White"/>
                    </StackPanel>
                </Grid>
                </Viewbox>


                    <ItemsControl ItemsSource="{Binding Shared.BBoxes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                <Canvas>
                                    <Border BorderBrush="{Binding BoxColor}" BorderThickness="2"
                                    Width="{Binding Width}" Height="{Binding Height}"
                                    Background="#20FF0000">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ClickCommand}" />
                                    </Border.InputBindings>
                                    <StackPanel>
                                    <TextBlock Text="{Binding Id}" Foreground="{StaticResource HUDYellow}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ClassLabel}" Foreground="White" FontSize="10"/>
                                </StackPanel>
                            </Border>
                                <!-- 🟢 BBox 중심점 -->
                                <Ellipse Width="4" Height="4"
                                     Stroke="Black" StrokeThickness="1"
                                     Fill="Lime"
                                     Canvas.Left="{Binding CenterX}"
                                     Canvas.Top="{Binding CenterY}">
                                </Ellipse>
                                    </Canvas>
                            </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
                <!-- 📋 TARGET INFO -->
                <GroupBox Grid.Row="1" Header="TARGET INFO">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <DataGrid ItemsSource="{Binding Shared.BBoxes}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="#111"
                          Foreground="DarkGray"
                          BorderThickness="0"
                          RowBackground="#222"
                          AlternatingRowBackground="#333">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Gray"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                <DataGridTextColumn Header="Class" Binding="{Binding ClassLabel}" Width="70"/>
                                <DataGridTextColumn Header="Conf" Binding="{Binding Confidence, StringFormat={}{0:P1}}" Width="70"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>
                                <DataGridTextColumn Header="Target Lat" Binding="{Binding TargetLat, StringFormat={}{0:F6}}" Width="120"/>
                                <DataGridTextColumn Header="Target Lon" Binding="{Binding TargetLon, StringFormat={}{0:F6}}" Width="120"/>


                                <!-- Control 버튼 컬럼 -->
                                <DataGridTemplateColumn Header="Control" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                                <Button Content="추적"
                                        Padding="6,2"
                                        FontSize="12"
                                        Command="{Binding DataContext.VideoStream.TrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"/>
                                                <Button Content="추적해제"
                                        Padding="6,2"
                                        FontSize="12"
                                        Command="{Binding DataContext.VideoStream.UntrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Border>

        <!-- 🎛 우측: 제어 및 상태 -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- NETWORK -->
                <RowDefinition Height="Auto"/>
                <!-- CONTROL MODE -->
                <RowDefinition Height="Auto"/>
                <!-- TARGET -->
                <RowDefinition Height="Auto"/>
                <!-- MOVEMENT -->
                <RowDefinition Height="*"/>
                <!-- MAP -->
            </Grid.RowDefinitions>

            <GroupBox Header="NETWORK" Grid.Row="0" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 왼쪽: 네트워크 상태 표시 (그대로 유지) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="Network:" VerticalAlignment="Center" Margin="5"/>
                        <Ellipse Width="20" Height="20" Fill="{Binding Network.NetworkStatusColor}" Stroke="Black" StrokeThickness="1" Margin="5"/>
                        <TextBlock Text="BLE:" VerticalAlignment="Center" Margin="5"/>
                        <Ellipse Width="20" Height="20" Fill="{Binding Network.BleStatusColor}" Stroke="Black" StrokeThickness="1" Margin="5"/>
                    </StackPanel>

                    <!-- 오른쪽: 위도·경도 + 설정 버튼 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">

                        <TextBlock Text="위도:" VerticalAlignment="Center" Margin="5"/>

                        <!-- TextBox: IsSet == false일 때 보임 -->
                        <TextBox Text="{Binding Map.Latitude, Mode=TwoWay}" Width="100" Margin="5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Map.IsSet}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- TextBlock: IsSet == true일 때 보임 -->
                        <TextBlock Text="{Binding Map.Latitude, StringFormat={}{0:F8}}" Width="100" Margin="5" VerticalAlignment="Center"
                       Visibility="{Binding Map.IsSet, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="경도:" VerticalAlignment="Center" Margin="5"/>

                        <TextBox Text="{Binding Map.Longitude, Mode=TwoWay}" Width="100" Margin="5">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Map.IsSet}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Text="{Binding Map.Longitude, StringFormat={}{0:F8}}" Width="100" Margin="5" VerticalAlignment="Center"
                       Visibility="{Binding Map.IsSet, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 설정 버튼 -->
                        <Button Content="설정"
                    Command="{Binding Map.SetStartPositionCommand}"
                    Width="70" Margin="5"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 제어 모드 -->
            <GroupBox Header="CONTROL MODE" Grid.Row="1" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="레이저:" Margin="5"/>
                        <ToggleButton Content="{Binding Control.LaserToggleText}" IsChecked="{Binding Control.IsLaserOn, Mode=TwoWay}" Width="80" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="격발:" Margin="5"/>
                        <ToggleButton Content="{Binding Control.FireModeText}" IsChecked="{Binding Control.IsAutoFire, Mode=TwoWay}" Width="80" Height="25"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="운용:" Margin="5"/>
                        <ToggleButton Content="{Binding Control.OperationModeText}" IsChecked="{Binding Control.IsAutoOperation, Mode=TwoWay}" Width="80" Height="25"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 표적 상태 -->
            <GroupBox Header="SHOTTING CONTROL" Grid.Row="2" Margin="0,0,0,5">

                    <UniformGrid Columns="2" Margin="10">
                        <Button Content="격발"
                        Command="{Binding Control.SendFireCommand}"
                        IsEnabled="{Binding Control.CanFire}"
                        FontWeight="Bold"
                        Height="90"
                        Width="135"
                        Margin="5"/>


                    <!-- 🔸 오른쪽: 비상정지 버튼 -->
                        <Button Content="⚠ 비상정지"
                        Style="{StaticResource EmergencyButtonStyle}"
                        Command="{Binding EmergencyStopCommand}"
                        Width="135" Height="90"/>
                </UniformGrid>
            </GroupBox>

            <!-- 움직임 상태 -->
            <GroupBox Header="MOVEMENT STATUS" Grid.Row="3" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 🤖 로봇 움직임 상태 -->
                    <GroupBox Header="ROBOT" Grid.Column="0" Margin="0,0,5,0">
                        <Grid Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- ▲ 위 -->
                            <Viewbox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                          Fill="{Binding Control.MoveForwardColor}"
                          RenderTransformOrigin="0.5,0.5"/>
                            </Viewbox>

                        </Grid>
                    </GroupBox>

                    <!-- 구분선 -->
                    <Separator Grid.Column="1"
                   Width="1"
                   Background="{StaticResource BorderBrushDark}"
                   Margin="10,0"/>

                    <!-- 🎯 짐벌 움직임 상태 -->
                    <GroupBox Header="GIMBAL" Grid.Column="2" Margin="5,0,0,0">
                        <Grid Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- ▲ 위 -->
                            <Viewbox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                          Fill="{Binding Control.GimbalUpColor}"
                          RenderTransformOrigin="0.5,0.5"/>
                            </Viewbox>

                            <!-- ▼ 아래 -->
                            <Viewbox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                          Fill="{Binding Control.GimbalDownColor}"
                          RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <!-- ◀ 왼쪽 -->
                            <Viewbox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                          Fill="{Binding Control.GimbalLeftColor}"
                          RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <!-- ▶ 오른쪽 -->
                            <Viewbox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                          Fill="{Binding Control.GimbalRightColor}"
                          RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>


            <!-- 지도 -->
            <GroupBox Header="MAP" Grid.Row="4" Margin="0,0,0,0">
                <gmap:GMapControl x:Name="MapControl"
                                  Margin="5"
                                  Zoom="{Binding Map.Zoom, Mode=OneWay}"
                                  MinZoom="2"
                                  MaxZoom="22"
                                  Position="{Binding Map.MapCenter, Mode=OneWay}"
                                  CanDragMap="True"
                                  MouseWheelZoomType="MousePositionAndCenter"
                                  MapProvider="{x:Static gmapcore:GMapProviders.BingSatelliteMap}"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
