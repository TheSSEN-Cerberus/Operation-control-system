<Window x:Class="Operation_Control_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Operation_Control_System.ViewModels" 
        Title="4족 보행 로봇 운용 통제 시스템"
        Height="768" Width="1280">
    


    <Window.DataContext>
        <!-- ViewModel을 코드비하인드나 DI에서 주입할 예정 -->
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 영상 및 객체 정보 -->
        <Border Grid.Column="0" BorderBrush="DarkGray" BorderThickness="1" Margin="5">
            <Grid>
                <!-- 영상 -->
                <Image Source="{Binding VideoStream.CurrentFrame}"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           VerticalAlignment="Top" />

                <!-- BBox 오버레이 -->
                <ItemsControl ItemsSource="{Binding VideoStream.BBoxes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding BoxColor}" BorderThickness="2"
                        Width="{Binding Width}" Height="{Binding Height}"
                        Background="#20FF0000"
                        MouseLeftButtonDown="OnBBoxClicked">
                                <StackPanel>
                                    <TextBlock Text="{Binding Id}" Foreground="Yellow" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ClassLabel}" Foreground="White" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 우측 제어 및 상태 -->
        <ScrollViewer Grid.Column="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 1행: 네트워크 상태 + 시작 위치 입력 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 네트워크 상태 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Zynq 네트워크 상태: " VerticalAlignment="Center"/>
                        <Ellipse Width="20" Height="20"
                                 Fill="{Binding Network.StatusColor}"
                                 Stroke="Black" StrokeThickness="1"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Network.StatusText}"
                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 구분선 -->
                    <Separator Grid.Column="1" Margin="10,0" Width="1"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                    <!-- 시작 위치 입력 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="위도:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Text="{Binding Map.StartLatitude, Mode=TwoWay}"
                                 Width="100" Margin="5"/>
                        <TextBlock Text="경도:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Text="{Binding Map.StartLongitude, Mode=TwoWay}"
                                 Width="100" Margin="5"/>
                        <Button Content="설정" Width="60" Margin="5"
                                Command="{Binding Map.SetStartPositionCommand}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5"/>

                <!-- 2행: 레이저/격발/운용모드 + 현재 로봇 위경도 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 레이저/격발/운용모드 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="레이저:" VerticalAlignment="Center"/>
                            <ToggleButton Content="{Binding Control.LaserToggleText}"
                                          IsChecked="{Binding Control.IsLaserOn, Mode=TwoWay}"
                                          Width="70" Height="25"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="격발:" VerticalAlignment="Center"/>
                            <ToggleButton Content="{Binding Control.FireModeText}"
                                          IsChecked="{Binding Control.IsAutoFire, Mode=TwoWay}"
                                          Width="70" Height="25"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="운용:" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Control.OperationModes}"
                                      SelectedItem="{Binding Control.SelectedOperationMode, Mode=TwoWay}"
                                      Width="100"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 구분선 -->
                    <Separator Grid.Column="1" Margin="10,0" Width="1"
                               HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                    <!-- 현재 로봇 위경도 -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="현재 위도:" Margin="5"/>
                        <TextBlock Text="{Binding Map.CurrentLatitude, StringFormat={}{0:F6}}" Margin="5"/>
                        <TextBlock Text="경도:" Margin="5"/>
                        <TextBlock Text="{Binding Map.CurrentLongitude, StringFormat={}{0:F6}}" Margin="5"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5"/>

                <!-- 3행: 표적 추적 및 격발 상태 -->
                <GroupBox Header="표적 추적 및 격발 상태" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 추적 중인 객체 ID -->
                        <TextBlock Text="추적 객체 ID:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{Binding Control.TrackedTargetId}" 
                   Grid.Row="0" Grid.Column="1" Margin="5"/>

                        <!-- 격발 가능 여부 및 버튼 -->
                        <TextBlock Text="격발:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <Button Content="격발" Width="70" Height="25" 
                    IsEnabled="{Binding Control.CanFire}"
                    Command="{Binding Control.SendFireCommand}"/>
                            <TextBlock Text="{Binding Control.FireStatusText}" 
                       Margin="8,0,0,0" 
                       VerticalAlignment="Center"
                       Foreground="Gray"/>
                        </StackPanel>

                        <!-- 격발 결과 (HIT / MISS) -->
                        <TextBlock Text="격발 결과:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <Button Content="HIT" Width="60" Margin="2"
                    Command="{Binding Control.ConfirmKillCommand}"
                    CommandParameter="true"/>
                            <Button Content="MISS" Width="60" Margin="2"
                    Command="{Binding Control.ConfirmKillCommand}"
                    CommandParameter="false"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <Separator Margin="0,5"/>

                <!-- 4행: 로봇 움직임 상태 + 김발 움직임 상태 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 로봇 움직임 상태 -->
                    <GroupBox Header="로봇 움직임 상태" Grid.Column="0" Margin="0,0,5,0">
                        <Grid Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- 위 -->
                            <Viewbox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.MoveForwardColor}"
                      RenderTransformOrigin="0.5,0.5"/>
                            </Viewbox>

                            <!-- 좌 -->
                            <Viewbox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.MoveLeftColor}"
                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <!-- 아래 -->
                            <Viewbox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.MoveBackwardColor}"
                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <!-- 우 -->
                            <Viewbox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.MoveRightColor}"
                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>
                        </Grid>
                    </GroupBox>

                    <!-- 구분선 -->
                    <Separator Grid.Column="1" Margin="10,0" Width="1"
               HorizontalAlignment="Center" VerticalAlignment="Stretch"
               Background="#444"/>

                    <!-- 김발 움직임 상태 -->
                    <GroupBox Header="김발 움직임 상태" Grid.Column="2" Margin="5,0,0,0">
                        <Grid Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- 상 -->
                            <Viewbox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.GimbalUpColor}"
                      RenderTransformOrigin="0.5,0.5"/>
                            </Viewbox>

                            <!-- 좌 -->
                            <Viewbox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.GimbalLeftColor}"
                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <!-- 하 -->
                            <Viewbox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.GimbalDownColor}"
                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <!-- 우 -->
                            <Viewbox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M10,0 L0,20 L20,20 Z"
                      Fill="{Binding Control.GimbalRightColor}"
                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>
                        </Grid>
                    </GroupBox>
                </Grid>

                <Separator Margin="0,5"/>

                <!-- 5행: 지도 표시 -->
                <GroupBox Header="지도 표시" Margin="0,0,0,10">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Map.KilledObjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="LightGray" Height="300"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="{Binding MiniMapPos.X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding MiniMapPos.Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10" Fill="{Binding MarkerColor}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
